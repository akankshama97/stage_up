# =============================================
# STAGEUP - .gitignore
# =============================================

# --- Dependencies (never commit) ---
node_modules/
*/node_modules/
**/.pnp
**/.pnp.js

# --- Build outputs ---
dist/
*/dist/
build/
*/build/
.next/
out/

# =============================================
# SENSITIVE / SECRET FILES — KABHI PUSH MAT KARO
# =============================================

# Environment variables (MongoDB URI, API keys, passwords)
.env
.env.local
.env.development
.env.production
.env.staging
.env.*
!.env.example
*.env
backend/.env
frontend/.env

# API keys / secrets (agar alag file me hain)
secrets.js
secrets.json
secrets.ts
config/secrets.*
private.key
*.pem
*.p12
*.pfx
*.key
*.cert
*.crt
serviceAccountKey.json
firebase-adminsdk*.json
google-credentials.json
aws-credentials.json
cloudinary.config.js

# JWT / Auth tokens
jwt.secret
auth.config.js

# Database credentials / connection strings
db.config.js
database.config.js
mongo.config.js

# Payment gateway keys (Razorpay, Stripe etc.)
razorpay.config.js
stripe.config.js

# --- Editor and OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing ---
coverage/
.nyc_output/

# --- Local Databases & Storage ---
*.sqlite
*.sqlite3
*.db
dump.rdb

# --- Temporary & Misc ---
.cache/
.parcel-cache/
.vercel
.turbo
*.tsbuildinfo
tmp/
temp/
.temp/
*.bak
*.orig
